# --- Telegram Local Bot API server ---
# From https://my.telegram.org -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Bot token for @S_Q_O_M_Bot (BotFather). The bot must be logged out of the
# cloud Bot API first (see README) before it can run in --local mode.
TELEGRAM_BOT_TOKEN=123456789:AA...

# --- TubePilot backend ---
# Stable public URL of the TubePilot deployment.
TUBEPILOT_BASE_URL=https://project--1dfef0fb-80d6-4442-b55e-ad7942f0dd3f.lovable.app
# Shared secret; must match the TELEGRAM_WORKER_SECRET secret stored in TubePilot.
TELEGRAM_WORKER_SECRET=replace-with-the-generated-secret

# --- Worker tuning (optional) ---
PORT=8080
POLL_INTERVAL_MS=3000
PROGRESS_INTERVAL_MS=1500
TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081
TELEGRAM_API_DIR=/var/lib/telegram-bot-api
